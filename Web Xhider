        .help-list li i { color: var(--primary); margin-top: 4px; flex-shrink: 0; }
        .help-list strong { color: var(--text-main); }
        .benefit-box { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-bottom: 20px; }
