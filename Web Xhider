<script>
    const fileData = [];
    const scriptBase = "";
    const isLoggedIn = false;

    function toggleSidebar() {
        document.querySelector('.sidebar').classList.toggle('active');
        document.querySelector('.sidebar-overlay').classList.toggle('active');
    }

    function formatSize(bytes) {
        if (bytes === undefined || bytes === null) return '-';
        if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + ' GB';
        if (bytes >= 1048576) return (bytes / 1048576).toFixed(2) + ' MB';
        if (bytes >= 1024) return (bytes / 1024).toFixed(2) + ' KB';
        return bytes + ' B';
    }

    function timeAgo(timestamp) {
        if (!timestamp) return '';
        const seconds = Math.floor((new Date() - timestamp * 1000) / 1000);
        let interval = seconds / 31536000;
        if (interval > 1) return Math.floor(interval) + "y ago";
        interval = seconds / 2592000;
        if (interval > 1) return Math.floor(interval) + "mo ago";
        interval = seconds / 86400;
        if (interval > 1) return Math.floor(interval) + "d ago";
        interval = seconds / 3600;
        if (interval > 1) return Math.floor(interval) + "h ago";
        interval = seconds / 60;
        if (interval > 1) return Math.floor(interval) + "m ago";
        return "Just now";
    }

    function renderTable(data) {
        const tbody = document.getElementById('fileListBody');
        tbody.innerHTML = '';
        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:40px; color:var(--text-sub)"><i class="fas fa-box-open" style="font-size:24px; display:block; margin-bottom:10px; opacity:0.5"></i>Empty Directory</td></tr>';
            return;
        }
        data.forEach(item => {
            let tr = document.createElement('tr');
            let iconHtml = item.type === 'folder' ? '<i class="fas fa-folder"></i>' : '<i class="fas fa-file-code"></i>';
            let nameHtml = '';
            if (item.type === 'folder') {
                nameHtml = `<a href="${scriptBase}/repo/${item.path}" class="folder-link">${item.name}</a>`;
            } else {
                let dName = item.display_name.split('/').pop();
                nameHtml = `<span style="font-family:'JetBrains Mono'; color:#e4e4e7; font-weight:500">${dName}</span>`;
            }
            let sizeHtml = item.type === 'file' ? formatSize(item.size) : '';
            
            // Hide views column for folders
            let viewsHtml = '';
            let viewsClass = 'col-views';
            if (item.type === 'folder') {
                viewsHtml = ''; 
                viewsClass += ' mobile-hide'; // hide on mobile
            } else {
                let vCount = item.views ? item.views : 0;
                viewsHtml = `<i class="fas fa-eye" style="margin-right:4px; opacity:0.6"></i> ${vCount}`;
            }

            let statusHtml = '';
            if (item.type === 'folder') {
                statusHtml = '<span style="font-size:12px; color:var(--text-sub); opacity:0.5">Folder</span>';
            } else {
                if (item.privacy === 'private') {
                    statusHtml = '<span class="status-badge status-private"><i class="fas fa-lock" style="font-size:10px"></i> Private</span>';
                } else {
                    statusHtml = '<span class="status-badge status-public">Public</span>';
                }
                statusHtml += ' <span class="col-size">' + sizeHtml + '</span>';
            }
            let timeHtml = '';
            if (item.type === 'folder') {
                timeHtml = '<span style="color:var(--text-sub); font-size:12px;">-</span>';
            } else if (item.expire == 0) {
                timeHtml = '<span class="perm">Never</span>';
            } else {
                timeHtml = `<span class="countdown" data-expire="${item.expire}">...</span>`;
            }
            let linkHtml = '';
            if (item.type === 'file') {
                linkHtml = `<button class="btn-icon" title="Copy Raw Link" onclick="copyText('${item.url}')"><i class="fas fa-link"></i></button>`;
            }
            let actionHtml = '';
            let toggleHtml = '';
            if (item.type === 'folder') {
                if (isLoggedIn) {
                    let safePath = item.path.replace(/'/g, "\\'");
                    let safeName = item.name.replace(/'/g, "\\'");
                    actionHtml = `<button type="button" class="btn-icon" title="Rename Folder" onclick="openFolderRenameModal('${safePath}', '${safeName}')"><i class="fas fa-pen"></i></button> <button type="button" class="btn-icon" title="Delete Folder" onclick="confirmDeleteFolder('${safePath}')" style="color:#ef4444"><i class="fas fa-trash"></i></button>`;
                }
            } else if (item.type === 'file') {
                if (isLoggedIn) {
                    let isChecked = item.active ? 'checked' : '';
                    toggleHtml = `
                        <label class="switch" title="Toggle Raw Access">
                            <input type="checkbox" ${isChecked} onchange="toggleFile('${item.key}', this)">
                            <span class="slider"></span>
                        </label>
                    `;
                    
                    if (item.display_name.toLowerCase().endsWith('.html')) {
                        let isRenderChecked = item.html_render ? 'checked' : '';
                        toggleHtml += `
                            <div style="display:inline-block; text-align:center; vertical-align:middle; margin-left:8px">
                                <label class="switch" title="Toggle HTML Preview">
                                    <input type="checkbox" ${isRenderChecked} onchange="toggleHtmlRender('${item.key}', this)">
                                    <span class="slider blue"></span>
                                </label>
                                <div style="font-size:9px; color:#3b82f6; margin-top:2px; font-weight:600">Web Mode</div>
                            </div>
                        `;
                    }
                }
                actionHtml += `<a href="${item.url}" target="_blank" class="btn-icon" title="View Raw"><i class="fas fa-external-link-alt"></i></a> `;
                if (isLoggedIn) {
                    let safeDisplay = item.display_name.replace(/'/g, "\\'");
                    let safeUrl = item.url.replace(/'/g, "\\'");
                    let priv = item.privacy || 'public';
                    let dur = item.duration || 0;
                    let isActive = item.active !== false; 
                    actionHtml += `<button type="button" class="btn-icon" title="Edit" onclick="editFile('${safeDisplay}', '${safeUrl}', '${priv}', '${dur}', ${isActive})"><i class="fas fa-pen"></i></button> `;
                }
                actionHtml += `<button type="button" class="btn-icon" title="Delete" onclick="confirmDelete('${item.key}')" style="color:#ef4444"><i class="fas fa-trash"></i></button>`;
            }
            let createdTimeStr = timeAgo(item.created);
            let mobileUploadTime = `<div class="mobile-upload-time">${createdTimeStr}</div>`;
            let desktopToggle = isLoggedIn && item.type === 'file' ? toggleHtml : '';
            let actionTdClass = item.type === 'folder' ? 'col-action folder-action-cell' : 'col-action';
            tr.innerHTML = `
                ${mobileUploadTime}
                <td class="col-icon">${iconHtml}</td>
                <td class="col-name">${nameHtml}</td>
                <td class="${viewsClass}">${viewsHtml}</td>
                <td class="col-status">${statusHtml}</td>
                <td class="col-time">${timeHtml}</td>
                <td class="col-link" style="text-align:center">${desktopToggle} ${linkHtml}</td>
                <td class="${actionTdClass}">${actionHtml}</td>
            `;
            tbody.appendChild(tr);
        });
        updateCountdowns();
    }

    function sortFiles(criteria) {
        document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('sort-' + criteria).classList.add('active');
        fileData.sort((a, b) => {
            if (a.type !== b.type) return a.type === 'folder' ? -1 : 1;
            if (criteria === 'newest') {
                return b.created - a.created;
            } else if (criteria === 'name_asc') {
                let nA = a.display_name || a.name;
                let nB = b.display_name || b.name;
                return nA.localeCompare(nB);
            } else if (criteria === 'size_desc') {
                return (b.size || 0) - (a.size || 0);
            }
            return 0;
        });
        renderTable(fileData);
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderTable(fileData);
            });

    function handleAuth(e, form) {
        e.preventDefault();
        const btn = form.querySelector('button');
        const oldText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        btn.disabled = true;
        const formData = new FormData(form);
        formData.append('ajax_mode', '1');
        fetch(window.location.href, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if(res.status === 'success') {
                    window.location.reload();
                } else {
                    const alertDiv = form.previousElementSibling; 
                    alertDiv.className = 'alert error active';
                    alertDiv.innerText = res.msg;
                    btn.innerHTML = oldText;
                    btn.disabled = false;
                }
            })
            .catch(err => {
                const alertDiv = form.previousElementSibling; 
                alertDiv.className = 'alert error active';
                alertDiv.innerText = "Network error";
                btn.innerHTML = oldText;
                btn.disabled = false;
            });
    }

    function handleGenerateToken(e, form) {
        e.preventDefault();
        const btn = form.querySelector('button');
        const oldIcon = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        btn.disabled = true;
        const formData = new FormData(form);
        formData.append('ajax_mode', '1');
        fetch(window.location.href, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                btn.innerHTML = oldIcon;
                btn.disabled = false;
                if(res.status === 'success') {
                    document.getElementById('apiTokenInput').value = res.token;
                    document.querySelectorAll('.token-ph').forEach(el => el.innerText = res.token);
                    const alertDiv = document.getElementById('settingsAlert');
                    alertDiv.className = 'alert success active';
                    alertDiv.innerText = res.msg;
                    setTimeout(() => { alertDiv.className = 'alert'; }, 3000);
                } else {
                    alert('Error: ' + res.msg);
                }
            })
            .catch(err => {
                btn.innerHTML = oldIcon;
                btn.disabled = false;
                alert('Network Error');
            });
    }

    function toggleFile(key, checkbox) {
        const formData = new FormData();
        formData.append('action', 'toggle_status');
        formData.append('key', key);
        formData.append('ajax_mode', '1');
        fetch(window.location.href, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if(res.status !== 'success') {
                    alert('Error toggling file status');
                    checkbox.checked = !checkbox.checked; 
                }
            })
            .catch(err => {
                alert('Network error');
                checkbox.checked = !checkbox.checked;
            });
    }

    function toggleHtmlRender(key, checkbox) {
        const formData = new FormData();
        formData.append('action', 'toggle_html_render');
        formData.append('key', key);
        formData.append('ajax_mode', '1');
        fetch(window.location.href, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if(res.status !== 'success') {
                    alert('Error toggling HTML render');
                    checkbox.checked = !checkbox.checked; 
                }
            })
            .catch(err => {
                alert('Network error');
                checkbox.checked = !checkbox.checked;
            });
    }

    function copyText(text) {
        const temp = document.createElement("textarea");
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand("copy");
        document.body.removeChild(temp);
        const btn = event.currentTarget;
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check" style="color:var(--green)"></i>';
        setTimeout(() => btn.innerHTML = original, 1000);
    }

    function copyCode(btn) {
        const content = btn.parentElement.nextElementSibling.innerText;
        const temp = document.createElement("textarea");
        temp.value = content;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand("copy");
        document.body.removeChild(temp);
        
        const originalText = btn.innerText;
        btn.innerText = "Copied!";
        btn.style.color = "#22c55e";
        setTimeout(() => {
            btn.innerText = originalText;
            btn.style.color = "";
        }, 1500);
    }

    function updateCountdowns() {
        const now = Math.floor(Date.now() / 1000);
        document.querySelectorAll('.countdown').forEach(el => {
            const expire = parseInt(el.getAttribute('data-expire'));
            let diff = expire - now;
            if (diff <= 0) { el.innerText = "Expired"; el.style.color = "#ef4444"; el.style.background = "rgba(239, 68, 68, 0.1)"; return; }
            const h = Math.floor(diff / 3600).toString().padStart(2,'0');
            const m = Math.floor((diff % 3600) / 60).toString().padStart(2,'0');
            const s = (diff % 60).toString().padStart(2,'0');
            el.innerText = `${h}:${m}:${s}`;
        });
    }
    updateCountdowns(); setInterval(updateCountdowns, 1000);

    function runObfuscate() {
        const content = document.getElementById('fileContent').value;
        if (!content.trim()) return alert("Content cannot be empty!");
        const btn = event.currentTarget;
        const oldHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
        btn.disabled = true;
        
        const fd = new FormData();
        fd.append('action', 'create_obf');
        fd.append('content', content);
        fd.append('preset', document.getElementById('obfPreset').value);
        fd.append('ajax_mode', '1');
        
        // Get filename from input
        const fileNameInput = document.getElementById('fileNameInput');
        if (fileNameInput && fileNameInput.value) {
            fd.append('filename', fileNameInput.value);
        }
        
        fetch(window.location.href, { method: 'POST', body: fd })
            .then(r => r.json())
            .then(res => {
                if (res.status === 'success') {
                    if (res.remaining_guest !== -1) {
                         const bar = document.getElementById('guestLimitBar');
                         const count = document.getElementById('guestLimitCount');
                         if(bar && count) {
                             bar.style.width = (res.remaining_guest / 5 * 100) + '%';
                             count.innerText = res.remaining_guest;
                         }
                    }
                    document.getElementById('fileContent').value = res.result;
                    btn.innerHTML = '<i class="fas fa-check"></i> Done';
                    setTimeout(() => { btn.innerHTML = oldHtml; btn.disabled = false; }, 2000);
                } else {
                    alert('Error: ' + res.msg);
                    btn.innerHTML = oldHtml;
                    btn.disabled = false;
                }
            })
            .catch(e => {
                alert('Network Error');
                btn.innerHTML = oldHtml;
                btn.disabled = false;
            });
    }

    function openModal(id) { document.getElementById(id+'Modal').classList.add('active'); }
    function closeModal(id) { document.getElementById(id+'Modal').classList.remove('active'); }
    function switchModal(c, o) { 
        closeModal(c); 
        document.getElementById(c+'Alert').className = 'alert';
        setTimeout(()=>openModal(o), 300); 
    }
    window.onclick = e => { if(e.target.classList.contains('modal-overlay')) e.target.classList.remove('active'); };

    function confirmSave() {
        if (!document.getElementById('fileContent').value.trim()) return alert("Content cannot be empty!");
        const m = document.getElementById('confirmModal');
        document.getElementById('confirmTitle').innerText = "Save File";
        document.getElementById('confirmText').innerText = "Do you want to save this file?";
        const b = document.getElementById('confirmBtnAction'); b.className = "btn btn-primary"; b.innerText="Save Now";
        b.onclick = () => {
            b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            document.getElementById('editorForm').submit();
        };
        openModal('confirm');
    }

    function confirmDelete(key) {
        document.getElementById('confirmTitle').innerText = "Delete File";
        document.getElementById('confirmText').innerText = "This action cannot be undone. Are you sure?";
        const b = document.getElementById('confirmBtnAction'); b.className = "btn btn-danger"; b.innerText="Delete Forever";
        b.onclick = () => { 
            b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';
            document.getElementById('deleteKeyInput').value=key; 
            document.getElementById('deleteForm').submit(); 
        };
        openModal('confirm');
    }

    function loadFile(i) {
        if(i.files[0]) {
            let fname = i.files[0].name;
            if(document.getElementById('fileNameInput')) {
                const currentVal = document.getElementById('fileNameInput').value;
                const lastSlash = currentVal.lastIndexOf('/');
                const prefix = lastSlash !== -1 ? currentVal.substring(0, lastSlash + 1) : '';
                document.getElementById('fileNameInput').value = prefix + fname;
            }
            toggleObf(fname);
            const r = new FileReader(); r.onload = e => document.getElementById('fileContent').value = e.target.result; r.readAsText(i.files[0]);
        }
    }

    function toggleObf(name) {
        if(!name) return;
        let isHtml = name.toLowerCase().endsWith('.html') || name.toLowerCase().endsWith('.htm');
        let btn = document.getElementById('btnObf');
        let pre = document.getElementById('presetContainer');
        if(isHtml) {
            if(btn) btn.style.display = 'none';
            if(pre) pre.style.visibility = 'hidden'; 
        } else {
            if(btn) btn.style.display = '';
            if(pre) pre.style.visibility = 'visible';
        }
    }
    
    let nameInput = document.getElementById('fileNameInput');
    if(nameInput) {
        nameInput.addEventListener('input', function() {
            toggleObf(this.value);
        });
    }

    function editFile(displayName, url, priv, dur, isActive) {
        if(document.getElementById('fileNameInput')) {
            document.getElementById('fileNameInput').value = displayName;
            document.getElementById('originNameInput').value = displayName;
        }
        toggleObf(displayName);
        if (priv === 'private') document.getElementById('priv_private').checked = true;
        else document.getElementById('priv_public').checked = true;
        if (document.getElementById('expireSelect')) document.getElementById('expireSelect').value = dur;
        
        if (!isActive) {
            document.getElementById('fileContent').value = "-- [SYSTEM] Raw Access is currently DISABLED.\n-- Enable it in the file list below to view or edit the content.";
            window.scrollTo({top:0, behavior:'smooth'});
            return;
        }

        const btn = event.currentTarget;
        const originalIcon = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        
        fetch(url).then(r => {
            if(r.status === 403) return "-- Raw Access Denied or Disabled";
            return r.text();
        }).then(t => { 
            document.getElementById('fileContent').value = t; 
            window.scrollTo({top:0, behavior:'smooth'});
            btn.innerHTML = originalIcon;
        }).catch(err => {
             document.getElementById('fileContent').value = "-- Error loading file";
             btn.innerHTML = originalIcon;
        });
    }

    function copyToClipboard(el) {
        el.select(); document.execCommand('copy');
        const old = el.value; el.value = "Copied!"; el.style.color = "#22c55e";
        setTimeout(() => { el.value = old; el.style.color = ""; }, 1000);
    }

    let currentFolderPath = '';

    function openFolderRenameModal(path, name) {
        currentFolderPath = path;
        document.getElementById('folderNewNameInput').value = name;
        const btn = document.getElementById('folderRenameContinueBtn');
        btn.innerHTML = 'Continue';
        btn.disabled = false;
        openModal('folderRename');
    }

    function submitRenameFolder() {
        const newName = document.getElementById('folderNewNameInput').value.trim().replace(/[^a-zA-Z0-9_.\-]/g, '');
        if (!newName) return alert('Please enter a valid folder name.');
        const btn = document.getElementById('folderRenameContinueBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        btn.disabled = true;
        const formData = new FormData();
        formData.append('action', 'rename_folder');
        formData.append('old_path', currentFolderPath);
        formData.append('new_name', newName);
        formData.append('ajax_mode', '1');
        fetch(window.location.href, { method: 'POST', body: formData })
            .then(r => r.json())
            .then(res => {
                if (res.status === 'success') {
                    closeModal('folderRename');
                    window.location.reload();
                } else {
                    alert('Error: ' + res.msg);
                    btn.innerHTML = 'Continue';
                    btn.disabled = false;
                }
            })
            .catch(() => {
                alert('Network error');
                btn.innerHTML = 'Continue';
                btn.disabled = false;
            });
    }

    function confirmDeleteFolder(path) {
        document.getElementById('confirmTitle').innerText = "Delete Folder";
        document.getElementById('confirmText').innerText = "This will permanently delete the folder and ALL files inside it. This action cannot be undone.";
        const b = document.getElementById('confirmBtnAction');
        b.className = "btn btn-danger";
        b.innerText = "Delete Forever";
        b.disabled = false;
        b.onclick = () => {
            b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';
            b.disabled = true;
            const formData = new FormData();
            formData.append('action', 'delete_folder');
            formData.append('folder_path', path);
            formData.append('ajax_mode', '1');
            fetch(window.location.href, { method: 'POST', body: formData })
                .then(r => r.json())
                .then(res => {
                    if (res.status === 'success') {
                        closeModal('confirm');
                        window.location.reload();
                    } else {
                        alert('Error: ' + res.msg);
                        b.innerHTML = 'Delete Forever';
                        b.disabled = false;
                    }
                })
                .catch(() => {
                    alert('Network error');
                    b.innerHTML = 'Delete Forever';
                    b.disabled = false;
                });
        };
        openModal('confirm');
    }
</script>

</body></html>
