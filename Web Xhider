            .container { padding: 0 10px; }
            .card-header { padding: 12px 15px; }
            .card-body { padding: 15px; }
            .modal-box { width: 95%; padding: 20px; }
            .table-responsive { overflow-x: hidden; border: none; }
            table, thead, tbody, th, td, tr { display: block; width: 100%; box-sizing: border-box; }
            thead tr { position: absolute; top: -9999px; left: -9999px; }
            tr { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; background: rgba(255,255,255,0.02); padding: 12px; position: relative; }
            td { border: none; padding: 2px 0; position: relative; }
            .col-icon { position: absolute; top: 12px; left: 12px; width: 24px; font-size: 20px; text-align: left;}
            .col-name { margin-left: 36px; margin-right: 80px; font-size: 15px; display: block; margin-bottom: 6px; word-break: break-all; line-height: 1.4; }
            .col-status { display: inline-block; margin-left: 36px; margin-right: 5px; }
            .col-size { display: inline-block; color: var(--text-sub); font-size: 12px; }
            .col-views { display: inline-block; margin-left: 36px; font-size: 12px; }
            .col-views:before { content: "Views: "; color: var(--text-sub); }
            .col-time { display: block; margin-left: 36px; margin-top: 6px; font-size: 11px; color: var(--text-sub); }
            .col-link, .col-action { display: inline-block; margin-top: 12px; margin-left: 0; padding-top: 10px; border-top: 1px dashed var(--border); width: 100%; }
            .col-link { border-top: none; padding-top: 0; width: auto; margin-right: 10px; margin-left: 36px;}
            .col-action { width: auto; border: none; padding: 0; margin-top: 10px; float: right; }
            .folder-action-cell { float: right; margin-top: -7px; border: none; padding: 0; width: auto; display: inline-block; }
            .mobile-upload-time { position: absolute; top: 14px; right: 12px; font-size: 11px; color: var(--text-sub); font-family: 'Inter', sans-serif; background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px; }
            .mobile-hide { display: none !important; }
        }
        @media (min-width: 769px) { .mobile-upload-time { display: none; } }
    </style>
</head>
